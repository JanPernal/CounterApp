<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CounterApp.ViewModels"
             xmlns:views="clr-namespace:CounterApp.Views"
             x:Class="CounterApp.MainPage"
             x:DataType="viewModels:MainViewModel"
             BackgroundColor="{StaticResource PageBackground}"
             Padding="18"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <!-- Phone / tablet: swipe -->
        <DataTemplate x:Key="SwipeCounterTemplate" x:DataType="viewModels:CounterViewModel">
            <SwipeView Threshold="220">
                <SwipeView.LeftItems>
                    <SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
                        <SwipeItemView Command="{Binding ResetCommand}">
                            <Border BackgroundColor="{StaticResource ResetColor}"
                                    Style="{StaticResource Action}"
                                    Margin="4,0">
                                <!-- MaterialIcons Reset-Icon -->
                                <Label Text="&#xE5D5;" Style="{StaticResource SwipeIcon}" />
                            </Border>
                        </SwipeItemView>
                    </SwipeItems>
                </SwipeView.LeftItems>

                <SwipeView.RightItems>
                    <SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
                        <SwipeItemView
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}}, Path=DeleteCounterCommand}"
                            CommandParameter="{Binding .}">
                            <Border BackgroundColor="{StaticResource DeleteColor}"
                                    Style="{StaticResource Action}"
                                    Margin="4,0">
                                <!-- MaterialIcons Delete-Icon -->
                                <Label Text="&#xE872;" Style="{StaticResource SwipeIcon}" />
                            </Border>
                        </SwipeItemView>
                    </SwipeItems>
                </SwipeView.RightItems>

                <views:CounterCard />
            </SwipeView>
        </DataTemplate>

        <!-- Desktop: card + buttons -->
        <DataTemplate x:Key="ButtonsCounterTemplate" x:DataType="viewModels:CounterViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <views:CounterCard Grid.Column="0" />
                <!-- MaterialIcons Reset-Icon -->
                <Button Grid.Column="1" Text="&#xE5D5;"
                        Command="{Binding ResetCommand}"
                        BackgroundColor="{StaticResource ResetColor}"
                        Style="{StaticResource ActionDesktop}" />
                <!-- MaterialIcons Delete-Icon -->
                <Button Grid.Column="2" Text="&#xE872;"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}}, Path=DeleteCounterCommand}"
                        CommandParameter="{Binding .}"
                        BackgroundColor="{StaticResource DeleteColor}"
                        Style="{StaticResource ActionDesktop}" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="0, 72, 0,36">
            <Label Grid.Column="0" Text="Counters" Style="{StaticResource Value}"
                   FontSize="32" VerticalOptions="Center" />

            <Button Grid.Column="1"
                    Command="{Binding ToggleAddFormCommand}"
                    FontFamily="MaterialIcons" FontSize="32"
                    WidthRequest="56" HeightRequest="56" CornerRadius="28" Padding="0"
                    BackgroundColor="{StaticResource TextPrimary}"
                    TextColor="{StaticResource CardBackground}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAddFormOpen}" Value="False">
                        <Setter Property="Text" Value="&#xE145;" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAddFormOpen}" Value="True">
                        <Setter Property="Text" Value="&#xE5CD;" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
        <Border Grid.Row="1"
                IsVisible="{Binding IsAddFormOpen}"
                BackgroundColor="{StaticResource CardBackground}"
                StrokeThickness="0" Padding="36" Margin="0,0,0, 18">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="50" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="12">
                <Entry Text="{Binding NewCounterName}" Placeholder="Counter name" Margin="4"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding NewInitialValue}" Placeholder="Initial value" />
                    <Button Grid.Column="1" Text="New Counter" Command="{Binding AddCounterCommand}"/>
                </Grid>
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding AvailableColors}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ColorOptionViewModel">
                            <Button BackgroundColor="{Binding Hex, Converter={StaticResource HexToColor}}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}},
                                    Path=SelectColorCommand}"
                                    CommandParameter="{Binding .}"
                                    WidthRequest="32" HeightRequest="32" CornerRadius="8"
                                    Margin="4">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderColor" Value="{Binding Hex, Converter={StaticResource HexToColor}, ConverterParameter=Dark}" />
                                        <Setter Property="BorderWidth" Value="3" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </Border>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Counters}"
                        ItemTemplate="{OnIdiom Phone={StaticResource SwipeCounterTemplate},
                                               Tablet={StaticResource SwipeCounterTemplate},
                                               Default={StaticResource ButtonsCounterTemplate}}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="18" />
            </CollectionView.ItemsLayout>
        </CollectionView>
    </Grid>

</ContentPage>