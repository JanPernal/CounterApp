            <FlexLayout Direction="Row"
                        JustifyContent="Center"
                        AlignContent="Center"
                        AlignItems="Center"
                        Padding="20"
                        >
                <Button
                    x:Name="AddButton"
                    Text="+"
                    SemanticProperties.Hint="Incremencts counter by 1 when clicked"
                    Clicked="OnAddBtnClicked"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                />
                <Button
                    x:Name="MinusButton"
                    Text="-"
                    SemanticProperties.Hint="Decrements counter by 1 when clicked"
                    Clicked="OnMinusBtnClicked"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"

                />
            </FlexLayout>
            <HorizontalStackLayout Spacing="12" Padding="20">


            </HorizontalStackLayout>
            <Label x:Name="CounterLabel"
                   Text=""
                   SemanticProperties.Hint="Shows current value of counter"
                   HorizontalOptions="Center"/>


        </VerticalStackLayout>
