<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CounterApp.ViewModels"
             xmlns:views="clr-namespace:CounterApp.Views"
             x:Class="CounterApp.MainPage"
             x:DataType="viewModels:MainViewModel"
             BackgroundColor="{StaticResource PageBackground}">
    <ContentPage.Resources>
        <!-- Phone / tablet: swipe -->
        <DataTemplate x:Key="SwipeCounterTemplate" x:DataType="viewModels:CounterViewModel">
            <SwipeView Threshold="220">
                <SwipeView.LeftItems>
                    <SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
                        <SwipeItemView Command="{Binding ResetCommand}">
                            <Border BackgroundColor="{StaticResource ResetColor}"
                                    Style="{StaticResource Action}"
                                    Margin="4,0">
                                <!-- MaterialIcons Reset-Icon -->
                                <Label Text="&#xE5D5;" Style="{StaticResource SwipeIcon}"/>
                            </Border>
                        </SwipeItemView>
                    </SwipeItems>
                </SwipeView.LeftItems>

                <SwipeView.RightItems>
                    <SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
                        <SwipeItemView
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}}, Path=DeleteCounterCommand}"
                            CommandParameter="{Binding .}">
                            <Border BackgroundColor="{StaticResource DeleteColor}"
                                    Style="{StaticResource Action}"
                                    Margin="4,0">
                                <!-- MaterialIcons Delete-Icon -->
                                <Label Text="&#xE872;" Style="{StaticResource SwipeIcon}"/>
                            </Border>
                        </SwipeItemView>
                    </SwipeItems>
                </SwipeView.RightItems>

                <views:CounterCard />
            </SwipeView>
        </DataTemplate>

        <!-- Desktop: card + buttons -->
        <DataTemplate x:Key="ButtonsCounterTemplate" x:DataType="viewModels:CounterViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <views:CounterCard Grid.Column="0" />
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto">
                    <Button Grid.Row="0" Text="Reset" Command="{Binding ResetCommand}"
                            BackgroundColor="{StaticResource ResetColor}"
                            Style="{StaticResource ActionDesktop}"/>
                    <Button Grid.Row="1" Text="Delete"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}}, Path=DeleteCounterCommand}"
                            CommandParameter="{Binding .}"
                            BackgroundColor="{StaticResource DeleteColor}"
                            Style="{StaticResource ActionDesktop}"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16" RowSpacing="12">
        <Entry Grid.Row="1" Text="{Binding NewCounterName}" Placeholder="Counter name" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Text="{Binding NewInitialValue}" Placeholder="Initial value" />
            <Button Grid.Column="1" Text="New Counter" Command="{Binding AddCounterCommand}" />
            <BoxView Grid.Column="2" Color="{Binding NewColorHex, Converter={StaticResource HexToColor}}"
                     WidthRequest="24" HeightRequest="24" CornerRadius="12" />
        </Grid>
        <FlexLayout Grid.Row="3" Wrap="Wrap"
                    BindableLayout.ItemsSource="{Binding AvailableColors}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="viewModels:ColorOptionViewModel">
                    <Button BackgroundColor="{Binding Hex, Converter={StaticResource HexToColor}}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}},
                            Path=SelectColorCommand}"
                            CommandParameter="{Binding .}"
                            WidthRequest="32" HeightRequest="32" CornerRadius="8"
                            Margin="4">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderColor" Value="Black" />
                                <Setter Property="BorderWidth" Value="3" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>
        <CollectionView Grid.Row="4" ItemsSource="{Binding Counters}"
                        ItemTemplate="{OnIdiom Phone={StaticResource SwipeCounterTemplate},
                                               Tablet={StaticResource SwipeCounterTemplate},
                                               Default={StaticResource ButtonsCounterTemplate}}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="36" />
            </CollectionView.ItemsLayout>
        </CollectionView>
    </Grid>
</ContentPage>