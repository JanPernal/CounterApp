<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CounterApp.MainPage">

    <ScrollView>
        <VerticalStackLayout>
            <Label Text="Counters" HorizontalOptions="Center" TextColor="Brown" Margin="10"></Label>
            <Button x:Name="counterBtn1" Text="Counter 1" Margin="10" Clicked="counterBtn1_Clicked"></Button>
            <Button x:Name="counterBtn2" Text="Counter 2" Margin="10" Clicked="counterBtn2_Clicked"></Button>
            <Button x:Name="counterBtn3" Text="Counter 3" Margin="10" Clicked="counterBtn3_Clicked"></Button>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
