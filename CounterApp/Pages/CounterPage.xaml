<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CounterApp.Pages.CounterPage"
             xmlns:vm="clr-namespace:CounterApp.ViewModels"
             xmlns:viewModels="clr-namespace:CounterApp.ViewModels"
             x:DataType="viewModels:CounterViewModel"
             Title="Counters">
    <VerticalStackLayout
        Padding="30,0"
        Spacing="25">
        <FlexLayout Direction="Row"
                    JustifyContent="Center"
                    AlignContent="Center"
                    AlignItems="Center"
                    Padding="20"
        >
            <Label Text="{Binding Name}" TextDecorations="Underline"/>
            <Label Text="{Binding Value}"/>
            <Button Text="+" Command="{Binding IncrementCommand}"/>
            <Button Text="-" Command="{Binding DecrementCommand}"/>
            <Button Text="Reset" Command="{Binding ResetCommand}"/>
        </FlexLayout>
    </VerticalStackLayout>
</ContentPage>