<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="CounterName" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style x:Key="Value" TargetType="Label">
        <Setter Property="FontFamily" Value="InterExtraBold" />
        <Setter Property="FontSize" Value="55" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style x:Key="PillBtn" TargetType="Button">
        <Setter Property="FontFamily" Value="InterExtraBold" />
        <Setter Property="FontSize" Value="55" />
    </Style>
</ResourceDictionary>